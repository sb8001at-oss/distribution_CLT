} else if(dist == "uniform"){
output$param1 <<- renderUI({
sliderInput("i_param1", "最小値", min = -50, max = 50, value = -20, step = 0.1)
})
output$param2 <<- renderUI({
sliderInput("i_param2", "最大値", min = -50, max = 50, value = 20, step = 0.1)
})
output$param3 <<- renderUI(NULL)
} else if(dist == "binom"){
output$param1 <<- renderUI({
sliderInput("i_param1", "試行回数", min = 1, max = 50, value = 10, step = 1)
})
output$param2 <<- renderUI({
sliderInput("i_param2", "成功確率", min = 0.01, max = 1, value = 0.5, step = 0.01)
})
output$param3 <<- renderUI(NULL)
} else if(dist == "poisson"){
output$param1 <<- renderUI({
sliderInput("i_param1", "平均値", min = 0.1, max = 50, value = 10, step = 0.1)
})
output$param2 <<- renderUI(NULL)
output$param3 <<- renderUI(NULL)
} else if(dist == "geom"){
output$param1 <<- renderUI({
sliderInput("i_param1", "確率", min = 0.01, max = 1, value = 0.5, step = 0.01)
})
output$param2 <<- renderUI(NULL)
output$param3 <<- renderUI(NULL)
} else if(dist == "hyper"){
output$param1 <<- renderUI({
sliderInput("i_param1", "白玉の数", min = 1, max = 50, value = 5, step = 1)
})
output$param2 <<- renderUI({
sliderInput("i_param2", "黒玉の数", min = 1, max = 50, value = 5, step = 1)
})
output$param3 <<- renderUI({
sliderInput("i_param3", "試行回数", min = 1, max = input$i_param1 + input$i_param2 - 1, value = round((input$i_param1 + input$i_param2 - 1)/2), step = 1
})
