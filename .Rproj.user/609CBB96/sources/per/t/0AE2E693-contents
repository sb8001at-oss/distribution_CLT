distributions = c(
  normal = "正規分布",
  uniform = "一様分布",
  binom = "二項分布",
  poisson = "ポアソン分布",
  goem = "幾何分布",
  hyper = "超幾何分布",
  nbiom = "負の二項分布",
  t = "t分布",
  cauchy = "コーシー分布",
  logistic = "ロジスティック分布",
  lnorm = "対数正規分布",
  beta = "ベータ分布",
